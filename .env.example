# Copy this file to .env and adjust for your local setup.
#
# The endpoint below assumes TerminusDB's docker container has its port
# published to the host that runs Node (per your dev setup: Alpine VM,
# with Docker + TerminusDB running inside it, and the VM's port 6363
# reachable at localhost). If the VM's networking is bridged/NATed
# differently, this may need to be the VM's IP instead of localhost.
TERMINUSDB_ENDPOINT=http://localhost:6363

# Default docker image credentials are user "admin" / key "root".
# If you customized TERMINUSDB_ADMIN_PASS (or similar) when standing up
# the container, put the real value here instead.
TERMINUSDB_USER=admin
TERMINUSDB_KEY=root
TERMINUSDB_ORG=admin

# Database (data product) name this prototype creates and writes to.
# Kept separate from any real project db name so it's obviously disposable.
TERMINUSDB_DB=tech_tree_dev

# SSH credentials for Alpine/Docker environment access (restricted MCP tools)
SSH_HOST=localhost
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
SSH_KEY_PATH=